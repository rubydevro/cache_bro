<% bro_hub_crumb "Keys", @key.truncate(60) %>
<% content_for :bro_hub_crumb_actions do %>
  <%= bro_hub_crumb_link "← All keys", root_path(store: cache_bro_store.name) %>
<% end %>

<%= bro_hub_hero eyebrow: "#{cache_bro_store.name} · #{cache_bro_ttl(@entry.ttl)} · #{cache_bro_size(@entry.size)}",
      title: "Key", lead: @key %>

<div class="bh-split">
  <section class="bh-split-main">
    <div class="bh-block-head"><h2 class="bh-h2">Value</h2></div>
    <% if @value %>
      <% if @value.error %>
        <div class="bh-alert bh-alert-error">This value could not be read: <%= @value.error %></div>
      <% else %>
        <p class="bh-meta"><%= @value.klass %><%= " · shown up to #{number_with_delimiter(CacheBro.config.value_preview_length)} characters" if @value.truncated %></p>
        <pre class="bh-cmd-code" style="white-space:pre-wrap;overflow-wrap:anywhere"><%= @value.preview %></pre>
      <% end %>
      <p class="bh-hint">This reveal was recorded in the audit log.</p>
    <% elsif cache_bro_allows?(:view_values) %>
      <p class="bh-hint">Values can hold personal data. Revealing one is recorded: who, which key, when.</p>
      <%= form_with url: reveal_key_path, method: :post do %>
        <%= hidden_field_tag :store, cache_bro_store.name %>
        <%= hidden_field_tag :key, @key %>
        <%= cache_bro_reason_field(:reveal) %>
        <%= submit_tag "Reveal value", name: nil, class: "bh-btn is-auto", style: "margin-top:14px" %>
      <% end %>
    <% else %>
      <p class="bh-hint">You may see that this key exists, not what it holds.</p>
    <% end %>
  </section>

  <div class="bh-split-aside">
    <section class="bh-block">
      <h2 class="bh-h2">Details</h2>
      <dl class="bh-dl">
        <dt>Store</dt><dd><%= cache_bro_store.name %></dd>
        <dt>Key</dt><dd><%= @key %></dd>
        <dt>Expires</dt><dd><%= cache_bro_ttl(@entry.ttl) %></dd>
        <dt>Size</dt><dd><%= cache_bro_size(@entry.size) %> serialized</dd>
      </dl>
    </section>

    <% if cache_bro_allows?(:delete) %>
      <section class="bh-block">
        <h2 class="bh-h2">Delete</h2>
        <p class="bh-hint">The next request that needs it will rebuild it. Recorded in the audit log.</p>
        <%= form_with url: key_path, method: :delete do %>
          <%= hidden_field_tag :store, cache_bro_store.name %>
          <%= hidden_field_tag :key, @key %>
          <%= cache_bro_reason_field(:delete) %>
          <%= submit_tag "Delete key", name: nil, class: "bh-btn is-auto", style: "margin-top:14px;background:var(--bh-red)" %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
